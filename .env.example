# Salin file ini menjadi `.env` lalu isi nilainya sesuai environment Anda.

# Database (Supabase PostgreSQL via session pooler)
# PENTING: pakai port 5432 (session pooler), BUKAN 6543 (transaction pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=5&pool_timeout=20&connect_timeout=20"

# Auth
AUTH_SECRET="ganti-dengan-string-acak-panjang"
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang"
AUTH_TRUST_HOST="true"

# Job pengingat PTP: POST /api/cron/ptp dengan header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="ganti-dengan-string-acak"

# Batas koneksi database per instance (isi 1 saat berjalan di serverless)
# DB_POOL_MAX=1

# Opsional: pindahkan folder bukti ke disk lain (default: storage/uploads)
# STORAGE_DIR="/var/lib/sipena/uploads"
